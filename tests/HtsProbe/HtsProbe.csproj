<Project Sdk="Microsoft.NET.Sdk">

  <!-- Managed-side regression probe: voice container -> engine -> parameter streams,
       folded into the same digest tests/reference/hts_regress.py prints.
       Compiles the sources directly (link), so it needs neither the TuneLab SDK nor
       a running host. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HtsProbe</RootNamespace>
    <AssemblyName>HtsProbe</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\src\MutaForTuneLab\Assets\InfFile.cs" Link="InfFile.cs" />
    <Compile Include="..\..\src\MutaForTuneLab\Assets\HtsVoice.cs" Link="HtsVoice.cs" />
    <Compile Include="..\..\src\MutaForTuneLab\Native\MutaHts.cs" Link="MutaHts.cs" />
  </ItemGroup>

</Project>
