    <Compile Include="..\..\src\MutaForTuneLab\Assets\InfFile.cs" Link="Assets\InfFile.cs" />
    <Compile Include="..\..\src\MutaForTuneLab\Synthesis\BankContext.cs" Link="Synthesis\BankContext.cs" />
    <Compile Include="..\..\src\MutaForTuneLab\Synthesis\BankAssembler.cs" Link="Synthesis\BankAssembler.cs" />
    <Compile Include="..\..\src\MutaForTuneLab\Synthesis\BankRenderer.cs" Link="Synthesis\BankRenderer.cs" />
    <Compile Include="..\..\src\MutaForTuneLab\Synthesis\BreathRenderer.cs" Link="Synthesis\BreathRenderer.cs" />
    <Compile Include="..\..\src\MutaForTuneLab\Synthesis\PinnedPhones.cs" Link="Synthesis\PinnedPhones.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The tests read the same data the plugin ships, not a copy of it. -->
    <Content Include="..\..\assets\ja-zh-phone-map.tsv" Link="ja-zh-phone-map.tsv" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\third_party\sinsy\dic\japanese.utf_8.table" Link="sinsy\dic\japanese.utf_8.table" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
