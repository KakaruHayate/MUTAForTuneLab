<Project Sdk="Microsoft.NET.Sdk">

  <!-- Bank assembly probe: replays the arithmetic fixtures (resampler, split, fades,
       ratios, planning) against the C# port. Links the sources, so it needs neither
       the TuneLab SDK nor a running host. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BankLoopProbe</RootNamespace>
    <AssemblyName>BankLoopProbe</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\src\MutaForTuneLab\Synthesis\BankAssembler.cs" Link="BankAssembler.cs" />
  </ItemGroup>

</Project>

