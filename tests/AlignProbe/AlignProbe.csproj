<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>AlignProbe</AssemblyName>
    <RootNamespace>AlignProbe</RootNamespace>
    <TuneLabDir Condition="'$(TuneLabDir)' == ''">J:\MUTA\TuneLab-2.1.1</TuneLabDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="TuneLab.Foundation">
      <HintPath>$(TuneLabDir)\TuneLab.Foundation.dll</HintPath>
    </Reference>
    <Reference Include="TuneLab.SDK">
      <HintPath>$(TuneLabDir)\TuneLab.SDK.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\src\MutaForTuneLab\Assets\KanaTable.cs" Link="KanaTable.cs" />
    <Compile Include="..\..\src\MutaForTuneLab\Assets\PinyinDictionary.cs" Link="PinyinDictionary.cs" />
    <Compile Include="..\..\src\MutaForTuneLab\Assets\InfFile.cs" Link="InfFile.cs" />
    <Compile Include="..\..\src\MutaForTuneLab\Assets\HtsVoice.cs" Link="HtsVoice.cs" />
    <Compile Include="..\..\src\MutaForTuneLab\Assets\VoiceLibrary.cs" Link="VoiceLibrary.cs" />
    <Compile Include="..\..\src\MutaForTuneLab\Native\Gbk.cs" Link="Gbk.cs" />
    <Compile Include="..\..\src\MutaForTuneLab\Native\MutaHts.cs" Link="MutaHts.cs" />
    <Compile Include="..\..\src\MutaForTuneLab\Native\NativeLibraries.cs" Link="NativeLibraries.cs" />
    <Compile Include="..\..\src\MutaForTuneLab\Synthesis\*.cs" />
  </ItemGroup>
</Project>
